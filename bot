# 处理授权指令
@bot.message_handler(commands=['qx'])
def authorize_user(message):
    if message.from_user.id == ADMIN_USER_ID:
        try:
            # 分割命令,获取用户ID
            command_parts = message.text.split()
            
            # 检查命令是否包含用户ID
            if len(command_parts) != 2:
                bot.send_message(message.chat.id, "请提供一个有效的用户ID。格式: /qx <用户ID>")
                return

            # 获取用户ID并确保它是数字
            user_id_str = command_parts[1]
            if not user_id_str.isdigit():
                bot.send_message(message.chat.id, "用户ID必须是一个有效的数字")
                return

            # 转换为整数
            user_id = int(user_id_str)

            # 授权用户
            authorized_users[user_id] = True
            save_authorized_users(authorized_users)
            bot.send_message(message.chat.id, f"用户 {user_id} 已被授权使用机器人")
        except Exception as e:
            bot.send_message(message.chat.id, f"发生错误: {e}")
    else:
        bot.send_message(message.chat.id, "你没有权限执行此操作")

# 处理撤销授权指令
@bot.message_handler(commands=['sc'])
def revoke_user(message):
    if message.from_user.id == ADMIN_USER_ID:
        try:
            user_id = int(message.text.split()[1])
            if user_id in authorized_users:
                del authorized_users[user_id]
                save_authorized_users(authorized_users)
                bot.send_message(message.chat.id, f"用户 {user_id} 的授权已被撤销")
            else:
                bot.send_message(message.chat.id, f"用户 {user_id} 没有授权")
        except Exception as e:
            bot.send_message(message.chat.id, "请输入正确的用户ID")
    else:
        bot.send_message(message.chat.id, "你没有权限执行此操作")

# 处理用户发送的姓名和手机号
@bot.message_handler(func=lambda message: message.text and message.text[0].isalpha())
def handle_input(message):
    if not check_user_in_channel(message.chat.id):
        bot.send_message(
            message.chat.id,
            "你需要加入指定的频道才能使用此机器人哦,请点击下方按钮进入频道后再操作。",
            reply_markup=create_channel_button()
        )
        return
    
    # 检查是否是授权用户
    if message.from_user.id not in authorized_users:
        bot.send_message(message.chat.id, "你没有权限使用此机器人")
        return

    try:
        name, mobileno = message.text.split()

        # 回复用户正在破解中
        bot.send_message(message.chat.id, "正在破解中 请稍候...")

        归属地 = query_phone_info(mobileno)
        id_prefix_value = get_id_prefix(归属地)
        completed_id_cards = complete_id_card(name, id_prefix_value)

        if not completed_id_cards:
            bot.send_message(message.chat.id, "身份证信息补齐失败")
            return

        # 初始化核验成功标记
        success = False
        # 处理生成的身份证号
        for id_card in completed_id_cards:
            result = verify_operator_three_elements(name, id_card, mobileno)
            if result:
                bot.send_message(message.chat.id, f"姓名:{name}\n手机号:{mobileno}\n身份证:{id_card}\nJuly破解结果:🟢运营商一致")
                success = True
                break  # 只返回第一个核验成功的结果
        
        # 如果没有任何核验成功的结果
        if not success:
            bot.send_message(message.chat.id, "全部核验失败破解失败")

    except Exception as e:
        bot.send_message(message.chat.id, "输入格式错误,请确保格式为:姓名 手机号")

