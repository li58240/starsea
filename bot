# 查询手机号信息
def query_phone_info(phone_number):
    url = f"https://shouji.bmcx.com/{phone_number}__shouji/"
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3",
    }
    try:
        response = requests.get(url, headers=headers)
        response.raise_for_status()
        soup = BeautifulSoup(response.content, "html.parser")
        location_info = soup.find("table", {"bgcolor": "#C5D5C5"})
        if location_info:
            location_rows = location_info.find_all("tr")
            for row in location_rows:
                cols = row.find_all("td")
                if len(cols) > 1:
                    key = cols[0].text.strip()
                    value = cols[1].text.strip()
                    if key == "归属地":
                        return value
                    elif key == "运营商":
                        return value
        return "未知"
    except requests.RequestException as e:
        print(f"请求错误: {e}")
        return "未知"

# 获取身份证前两位
def get_id_prefix(location):
    for key, value in id_prefix.items():
        if key in location:
            return value
    return "未知"

# 补全身份证号码
def complete_id_card(name, id_prefix_value):
    api_url = f"http://kubu.hlkt.uk/杀神大王的库补接口.php?name={name}&cardno={id_prefix_value}xxxxxxxxxxxxxxxx"
    try:
        response = requests.get(api_url)
        response.raise_for_status()
        id_numbers = re.findall(r"\d{17}[\dX]", response.text)
        return id_numbers if id_numbers else []
    except requests.RequestException as e:
        print(f"API 请求错误: {e}")
        return []

# 构建 URL
def build_url(name, idcard, mobileno):
    base_url = "https://nbapp.ihuiyin.com/esign/RequestIDCode"
    params = {
        "name": urllib.parse.quote(name),
        "idcardno": idcard,
        "mobileno": mobileno
    }
    query_string = urllib.parse.urlencode(params)
    return f"{base_url}?{query_string}"

# 验证运营商信息
def verify_operator_three_elements(name, idcard, mobileno):
    url = build_url(name, idcard, mobileno)
    try:
        response = requests.get(url, timeout=20)
        response.raise_for_status()
        data = response.json()
        Type_field = data.get('Type')
        return Type_field == 0
    except requests.RequestException as e:
        print(f"请求错误: {e}")
        return False
    except ValueError:
        print("响应解析错误")
        return False

